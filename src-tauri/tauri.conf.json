{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "CQUST Wi-Fi",
 "version": "5.1.0",
 "identifier": "cn.ziyis.cqustwifi",
 "build": {
  "frontendDist": "../ui"
 },
 "app": {
  "withGlobalTauri": true,
  "windows": [
   {
    "label": "main",
    "title": "CQUST Wi-Fi",
    "width": 440,
    "height": 820,
    "minWidth": 440,
    "maxWidth": 440,
    "minHeight": 650,
    "decorations": false,
    "resizable": false,
    "maximizable": false,
    "fullscreen": false,
    "visible": false,
    "center": true,
    "backgroundColor": "#F5F7FB"
   }
  ],
  "security": {
   "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
 },
 "bundle": {
  "active": true,
  "targets": [
   "nsis"
  ],
  "icon": [
   "icons/icon.ico"
  ],
  "windows": {
   "webviewInstallMode": {
    "type": "downloadBootstrapper"
   },
   "nsis": {
    "displayLanguageSelector": false,
    "languages": [
     "SimpChinese"
    ],
    "installMode": "currentUser",
    "headerImage": "icons/installer-header.bmp",
    "installerIcon": "icons/installer-school.ico",
    "uninstallerIcon": "icons/installer-school.ico"
   }
  }
 }
}
